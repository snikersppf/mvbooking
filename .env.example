# Application runtime. Supply real values only in a protected runtime environment.
DATABASE_URL=
AUTH_SECRET=
AUTH_URL=
APP_ORIGIN=
TRUST_PROXY_HEADERS=
CRON_SECRET=

# Production notifications. Resend verified sender; Telegram manager chat only.
RESEND_API_KEY=
EMAIL_FROM=
TELEGRAM_BOT_TOKEN=
TELEGRAM_MANAGER_CHAT_ID=

# Read-only production-data audit: the owned, permanent HTTPS image origin.
VEHICLE_IMAGE_ORIGIN=

# Host backup/scheduler settings have their own blank template:
# deploy/operations.env.example (keep actual credentials outside this repository).

# Production Compose PostgreSQL initialization (not Docker build arguments).
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Playwright only; must point to a separate database whose name ends in _test.
E2E_DATABASE_URL=
# Local development seed only. Never supply this in production.
SEED_PASSWORD=

# Framework/container controls; normally set by Next.js or the Dockerfile.
# Leave commented to retain defaults, or supply the documented values.
# NODE_ENV=
# HOSTNAME=
# PORT=
# NEXT_TELEMETRY_DISABLED=
# Internal Next.js phase; never configure this in production runtime.
# NEXT_PHASE=
