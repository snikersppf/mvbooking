# Application runtime. Supply real values only in a protected runtime environment.
DATABASE_URL=
AUTH_SECRET=
AUTH_URL=
APP_ORIGIN=
TRUST_PROXY_HEADERS=
CRON_SECRET=

# Production Compose PostgreSQL initialization (not Docker build arguments).
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Playwright only; must point to a separate database whose name ends in _test.
E2E_DATABASE_URL=
# Local development seed only. Never supply this in production.
SEED_PASSWORD=

# Framework/container controls; normally set by Next.js or the Dockerfile.
# Leave commented to retain defaults, or supply the documented values.
# NODE_ENV=
# HOSTNAME=
# PORT=
# NEXT_TELEMETRY_DISABLED=
# Internal Next.js phase; never configure this in production runtime.
# NEXT_PHASE=
