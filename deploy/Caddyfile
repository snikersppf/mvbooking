{$APP_ORIGIN} {
    # Direct Internet ingress. A CDN/load balancer in front requires a reviewed trust policy.
    # Only vehicle upload endpoints accept larger multipart bodies.
    @vehicleUpload {
        method POST PUT
        path /api/admin/vehicles /api/admin/vehicles/*/images
    }
    request_body @vehicleUpload {
        max_size 20MB
    }
    @otherRequests {
        not {
            method POST PUT
            path /api/admin/vehicles /api/admin/vehicles/*/images
        }
    }
    request_body @otherRequests {
        max_size 1MB
    }
    encode zstd gzip
    reverse_proxy app:3000 {
        header_up -Forwarded
        header_up X-Forwarded-For {remote_host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-Host {host}
        header_up Host {host}
    }
    header Strict-Transport-Security "max-age=31536000; includeSubDomains"
}
